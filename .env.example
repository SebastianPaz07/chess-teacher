# Copia este archivo a .env.local y rellena con los datos de tu proyecto Supabase
# (Project Settings -> API). Sin estas variables la app funciona en modo local/demo.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Pega aquí la "publishable key" (sb_publishable_...), que es la nueva "anon key".
# NUNCA pongas la "secret key" en el frontend.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
